{
  "name": "Numbott Telethon",
  "description": "Advanced Modular Telegram Account Shop Bot with Custom UI and Multi-Payment Systems.",
  "repository": "https://github.com/ragini19854-prog/number_purchase_bot",
  "logo": "https://cdn.worldvectorlogo.com/logos/telegram-1.svg",
  "keywords": [
    "telegram",
    "bot",
    "shop",
    "telethon",
    "python"
  ],
  "env": {
    "API_ID": {
      "description": "Get this from my.telegram.org",
      "required": true
    },
    "API_HASH": {
      "description": "Get this from my.telegram.org",
      "required": true
    },
    "BOT_TOKEN": {
      "description": "Get this from @BotFather",
      "required": true
    },
    "ADMIN_ID": {
      "description": "Your Telegram User ID",
      "required": true
    },
    "LOG_CHANNEL_ID": {
      "description": "Primary Log Channel ID",
      "required": true
    },
    "LOG_CHANNEL_ID_2": {
      "description": "Secondary Log Channel ID (Optional)",
      "required": false
    },
    "CHECK_CHANNELS": {
      "description": "Comma separated Must-Join Channel IDs",
      "required": true
    },
    "JOIN_URLS": {
      "description": "Comma separated Must-Join Channel URLs",
      "required": true
    },
    "UPI_ID": {
      "description": "Your UPI ID for Indian Payments",
      "required": false
    },
    "CWALLET_ID": {
      "description": "Your Crypto Wallet ID",
      "required": false
    },
    "CWALLET_QR": {
      "description": "Your Crypto Wallet QR Image URL",
      "required": false
    },
    "HERO_SMS_API_KEY": {
      "description": "Hero SMS API key (hero-sms.com)",
      "required": false
    },
    "LZT_API_KEY": {
      "description": "LZT Market (lzt.market) API token - powers Telegram Server 3 (30+ days aged accounts)",
      "required": false
    },
    "LZT_SEARCH_PARAMS": {
      "description": "Optional extra LZT search filters, e.g. origin[]=self_registration (use /lztparams to see options)",
      "required": false
    },
    "PAYMENT_LOG_CHANNEL": {
      "description": "Payment logger group id (deposits, approvals, money added)",
      "required": false
    },
    "SERVICE_LOG_CHANNEL": {
      "description": "Service log channel id (every sale with cost/profit)",
      "required": false
    }
  },
  "buildpacks": [
    {
      "url": "heroku/python"
    }
  ],
  "formation": {
    "worker": {
      "quantity": 1,
      "size": "eco"
    }
  }
}